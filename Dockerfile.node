FROM node:20-alpine

# Load envs from github runner to container image
ARG PORT
ARG MONGODB_URI
ARG CROS_ORIGIN
ARG ACCESS_TOKEN_SECRET
ARG ACCESS_TOKEN_EXPIRY
ARG REFRESH_TOKEN_SECRET
ARG REFRESH_TOKEN_EXPIRY
ARG CLOUDINARY_CLOUD_NAME
ARG CLOUDINARY_API_KEY
ARG CLOUDINARY_SECRET_KEY
ARG RAPID_API_KEY
ARG CODECLASH_CODE_EXECUTION

ENV PORT=$PORT
ENV MONGODB_URI=$MONGODB_URI
ENV CROS_ORIGIN=$CROS_ORIGIN
ENV ACCESS_TOKEN_SECRET=$ACCESS_TOKEN_SECRET
ENV ACCESS_TOKEN_EXPIRY=$ACCESS_TOKEN_EXPIRY
ENV REFRESH_TOKEN_SECRET=$REFRESH_TOKEN_SECRET
ENV REFRESH_TOKEN_EXPIRY=$REFRESH_TOKEN_EXPIRY
ENV CLOUDINARY_CLOUD_NAME=$CLOUDINARY_CLOUD_NAME
ENV CLOUDINARY_API_KEY=$CLOUDINARY_API_KEY
ENV CLOUDINARY_SECRET_KEY=$CLOUDINARY_SECRET_KEY
ENV RAPID_API_KEY=$RAPID_API_KEY
ENV CODECLASH_CODE_EXECUTION=$CODECLASH_CODE_EXECUTION

# Hardcode envs for production
ENV NODE_ENV=production
ENV PORT=8000

WORKDIR /app

# Copy package files first (for better caching)
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy source
COPY . .

# Expose port used by your app
EXPOSE 8000

# Healthcheck uses internal HTTP endpoint - ensure you have /health or /
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || curl -f http://localhost:8000/ || exit 1

# Start the server
CMD ["node", "src/index.js"]
